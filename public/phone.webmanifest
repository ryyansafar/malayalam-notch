{
  "name": "rowing-call",
  "short_name": "rowing-call",
  "start_url": "/phone",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", ".opus", ".ogg", ".oga", ".m4a", ".mp4", ".aac", ".amr", ".mp3", ".wav", ".webm", ".flac"]
        }
      ]
    }
  }
}
