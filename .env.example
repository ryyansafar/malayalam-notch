# Copy to .env (never commit). Loaded by server/index.js if present.
SARVAM_API_KEY=
# live | replay | auto  (auto = live if key present, else replay)
SARVAM_MODE=auto
PORT=3000
# Optional local HTTPS: paths to a cert and key
CERT_FILE=
KEY_FILE=
# Optional: smallest.ai key (alternative voice for spoken translations). Follows SARVAM_MODE.
SMALLEST_API_KEY=
# 0 = do not create the default voice-note inbox folder ~/Downloads/malayalam-notch-inbox
WATCH_INBOX=1
# Comma-separated extra folders to watch for new audio (absolute paths, ~ allowed)
WATCH_DIRS=
# Language used when notes arrive through watched folders
WATCH_LANG=en-IN

# Phone-call reminders through Sarvam Voice Agents (all optional; without them reminders are spoken on the Mac).
# Create the agent on the Sarvam Voice Agents dashboard (Genie), deploy a phone number, then fill these in.
SARVAM_VOICE_API_KEY=
SARVAM_VOICE_ORG_ID=
SARVAM_VOICE_WORKSPACE_ID=
SARVAM_VOICE_APP_ID=
SARVAM_VOICE_APP_VERSION=
SARVAM_VOICE_CONNECTION_ID=
SARVAM_VOICE_AGENT_NUMBER=
