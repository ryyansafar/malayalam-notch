# Copy to .env (never commit). Loaded by server/index.js if present.
SARVAM_API_KEY=
# live | replay | auto  (auto = live if key present, else replay)
SARVAM_MODE=auto
PORT=3000
# Optional local HTTPS: paths to a cert and key
CERT_FILE=
KEY_FILE=
# Optional: smallest.ai key (alternative voice, Malayalam coach playback, second ear). Follows SARVAM_MODE.
SMALLEST_API_KEY=
# 1 = also transcribe each spoken shout with smallest.ai Pulse and compare the two meanings (default off)
SECOND_EAR=0
# 1 = when the keyword rules find no keyword at all, ask the hosted chat model (sarvam-105b) for one of the
# six meanings. Never used for negated or conflicting text. Uses SARVAM_API_KEY and SARVAM_MODE (default off)
MODEL_FALLBACK=0
