{
  "name": "malayalam-notch",
  "version": "0.1.0",
  "private": true,
  "description": "Malayalam in the notch: drag a WhatsApp voice note toward the MacBook notch, it expands, transcribes and translates the Malayalam, and can speak the result in another language.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "notch": "malayalam-notch/build.sh && open \"malayalam-notch/build/Malayalam Notch.app\"",
    "test": "node --test test/",
    "record": "node sarvam/record-fixtures.js",
    "ingest": "node server/ingest.js"
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4"
  },
  "keywords": [
    "malayalam",
    "notch",
    "macos",
    "whatsapp",
    "voice-notes",
    "sarvam",
    "speech-to-text",
    "translation"
  ]
}
